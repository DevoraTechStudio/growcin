        "@id": "https://www.growcin.com#faq-q1-how-does-budget-risk-detection-work",
        "url": "https://www.growcin.com#faq-q1-how-does-budget-risk-detection-work",
        "name": "How does budget risk detection work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "@id": "https://www.growcin.com#faq-q1-how-does-budget-risk-detection-work-answer",
          "text": "Growcin monitors CPA movement, spend anomalies, creative fatigue, and lead quality signals across your Meta campaigns. When budget is exposed, the platform flags the affected campaign and explains what changed."
        }
      },
      {
        "@type": "Question",
        "@id": "https://www.growcin.com#faq-q2-what-is-a-cpa-guardrail",
        "url": "https://www.growcin.com#faq-q2-what-is-a-cpa-guardrail",
        "name": "What is a CPA guardrail?",
        "acceptedAnswer": {
          "@type": "Answer",
          "@id": "https://www.growcin.com#faq-q2-what-is-a-cpa-guardrail-answer",
          "text": "A CPA guardrail is a maximum cost-per-lead threshold you set. When actual CPA moves beyond that threshold, Growcin surfaces the risk early so your team can review the campaign before spend compounds."
        }
      },
      {
        "@type": "Question",
        "@id": "https://www.growcin.com#faq-q3-how-does-creative-fatigue-monitoring-work",
        "url": "https://www.growcin.com#faq-q3-how-does-creative-fatigue-monitoring-work",
        "name": "How does creative fatigue monitoring work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "@id": "https://www.growcin.com#faq-q3-how-does-creative-fatigue-monitoring-work-answer",
          "text": "The platform watches signals such as CTR decline, frequency increases, hook-rate decay, and CPA movement. When a creative starts deteriorating, it shows the likely cause and recommended next action."
        }
      },
      {
        "@type": "Question",
        "@id": "https://www.growcin.com#faq-q4-what-does-lead-qualification-do",
        "url": "https://www.growcin.com#faq-q4-what-does-lead-qualification-do",
        "name": "What does lead qualification do?",
        "acceptedAnswer": {
          "@type": "Answer",
          "@id": "https://www.growcin.com#faq-q4-what-does-lead-qualification-do-answer",
          "text": "Every lead passes through an AI qualification layer. The platform asks pre-set questions via chatbot, and only routes high-intent leads to your sales team."
        }
      },
      {
        "@type": "Question",
        "@id": "https://www.growcin.com#faq-q5-does-ai-chat-assist-replace-my-meta-ads-manager",
        "url": "https://www.growcin.com#faq-q5-does-ai-chat-assist-replace-my-meta-ads-manager",
        "name": "Does Growcin replace my Meta Ads Manager?",
        "acceptedAnswer": {
          "@type": "Answer",
          "@id": "https://www.growcin.com#faq-q5-does-ai-chat-assist-replace-my-meta-ads-manager-answer",
          "text": "No. Growcin connects to your existing Meta Ads Manager account - it does not replace it. You keep full access to Ads Manager while adding a campaign intelligence layer on top."
        }
      },
      {
        "@type": "Question",
        "@id": "https://www.growcin.com#faq-q6-why-not-just-use-meta-alerts",
        "url": "https://www.growcin.com#faq-q6-why-not-just-use-meta-alerts",
        "name": "Why not just use Meta alerts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "@id": "https://www.growcin.com#faq-q6-why-not-just-use-meta-alerts-answer",
          "text": "Meta alerts tell you something happened. Growcin adds context by explaining why it happened, which campaigns are affected, and what action your team should consider next."
        }
